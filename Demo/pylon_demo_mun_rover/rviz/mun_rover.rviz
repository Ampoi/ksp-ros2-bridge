Panels:
- Class: rviz_common/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /TF1/Frames1
    - /TF1/Tree1
    Splitter Ratio: 0.5833333134651184
  Tree Height: 287
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded:
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.3333333432674408
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Ground traversability
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 5
    Alpha: 0.65
    Color Scheme: map
  - Class: rviz_default_plugins/Map
    Name: Local costs
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/local_costmap/costmap
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 5
    Alpha: 0.65
    Color Scheme: costmap
  - Class: rviz_default_plugins/PointCloud2
    Name: 3D LiDAR
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 5
    Size (m): 0.1
    Style: Points
    Color Transformer: FlatColor
    Color: 180; 190; 210
    Position Transformer: XYZ
  - Class: rviz_default_plugins/PointCloud2
    Name: Ground
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/ground
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 5
    Size (m): 0.1
    Style: Points
    Color Transformer: FlatColor
    Color: 70; 220; 130
    Position Transformer: XYZ
  - Class: rviz_default_plugins/PointCloud2
    Name: Obstacles
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/obstacles
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 5
    Size (m): 0.1
    Style: Points
    Color Transformer: FlatColor
    Color: 255; 60; 50
    Position Transformer: XYZ
  - Class: rviz_default_plugins/Path
    Name: Planned path
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
    Color: 60; 180; 255
    Line Style: Billboards
    Line Width: 0.1
  - Class: rviz_default_plugins/Path
    Name: Driven path
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/trajectory
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
    Color: 255; 210; 60
    Line Style: Billboards
    Line Width: 0.1
  - Class: rviz_default_plugins/Polygon
    Name: Rover footprint
    Enabled: true
    Topic:
      Value: /pylon/mun_rover/local_costmap/published_footprint
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
    Color: 100; 180; 255
  - Class: rviz_default_plugins/Marker
    Name: Status
    Enabled: true
    Marker Topic:
      Value: /pylon/mun_rover/status_marker
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.06853891909122467
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  - Class: nav2_rviz_plugins/GoalTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 45
      Pitch: 1.1
      Yaw: 0.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: <Fixed Frame>
Window Geometry:
  Displays:
    collapsed: false
  Docking:
    collapsed: false
  Height: 893
  Hide Left Dock: false
  Hide Right Dock: false
  Navigation 2:
    collapsed: false
  QMainWindow State: 
  RealsenseCamera:
    collapsed: false
  Selection:
    collapsed: false
  Selector:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1610
  X: 1091
  Y: 222
