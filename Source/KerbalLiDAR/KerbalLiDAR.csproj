<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>KerbalLiDAR</AssemblyName>
    <RootNamespace>KerbalLiDAR</RootNamespace>
    <OutputPath>..\..\GameData\KerbalLiDAR\Plugins\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(KSPDIR)' == ''">
    <KSPDIR>C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program</KSPDIR>
  </PropertyGroup>

  <PropertyGroup Condition="'$(KSPManagedDir)' == '' and Exists('$(KSPDIR)\KSP_Data\Managed\Assembly-CSharp.dll')">
    <KSPManagedDir>$(KSPDIR)\KSP_Data\Managed</KSPManagedDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(KSPManagedDir)' == ''">
    <KSPManagedDir>$(KSPDIR)\KSP_x64_Data\Managed</KSPManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />

    <Reference Include="Assembly-CSharp">
      <HintPath>$(KSPManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KSPManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KSPManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(KSPManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KSPManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
