<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>PyLoN</AssemblyName>
    <RootNamespace>PyLoN</RootNamespace>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <ModOutputDir>$(MSBuildProjectDirectory)/../../GameData/PyLoN</ModOutputDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(KSPDIR)' == ''">
    <KSPDIR>C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program</KSPDIR>
  </PropertyGroup>

  <PropertyGroup Condition="'$(KSPManagedDir)' == '' and Exists('$(KSPDIR)\KSP_Data\Managed\Assembly-CSharp.dll')">
    <KSPManagedDir>$(KSPDIR)\KSP_Data\Managed</KSPManagedDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(KSPManagedDir)' == ''">
    <KSPManagedDir>$(KSPDIR)\KSP_x64_Data\Managed</KSPManagedDir>
  </PropertyGroup>

  <!-- Only production layers are compiled. Local tooling is never imported. -->
  <ItemGroup>
    <Compile Include="Domain/**/*.cs;Application/**/*.cs;Api/Ksp/**/*.cs;Properties/AssemblyInfo.cs"
             Exclude="Api/Ksp/**/Debug*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />

    <Reference Include="Assembly-CSharp">
      <HintPath>$(KSPManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KSPManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KSPManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(KSPManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KSPManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(KSPManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(KSPManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(KSPManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Assets are tracked inputs; GameData is a disposable installation tree. -->
  <ItemGroup>
    <ModAsset Include="../../Assets/PyLoN/**/*" />
  </ItemGroup>
  <Target Name="AssembleGameData" AfterTargets="Build">
    <Error Condition="!Exists('../../Assets/PyLoN/Config/Runtime.cfg')"
           Text="Missing mod assets: Assets/PyLoN/Config/Runtime.cfg" />
    <RemoveDir Directories="$(ModOutputDir)" />
    <MakeDir Directories="$(ModOutputDir)/Plugins" />
    <Copy SourceFiles="@(ModAsset)"
          DestinationFiles="@(ModAsset->'$(ModOutputDir)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)/Plugins" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModOutputDir)/Plugins"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>
</Project>
