<?xml version="1.0"?>
<package format="3">
  <name>pylon_bridge</name>
  <version>0.3.0</version>
  <description>Bridge PyLoN sensors, robotic motors, vessel propulsion, and active-vessel runtime URDF proxies to ROS2.</description>
  <maintainer email="user@example.com">PyLoN</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>pylon_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
